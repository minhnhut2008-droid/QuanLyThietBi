rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed(){ return request.auth != null; }
    function role(){ return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin(){ return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() == 'admin'; }
    function isUser(){ return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) && role() in ['admin','user']; }
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'pending';
      allow update, delete: if isAdmin();
    }
    match /devices/{id} { allow read: if isUser(); allow write: if isAdmin(); }
    match /staff/{id}   { allow read: if isUser(); allow write: if isAdmin(); }
    match /holders/{id}   { allow read, write: if isUser(); }
    match /transfers/{id} { allow read, write: if isUser(); }
    match /requests/{id}  { allow read, write: if isUser(); }
  }
}
